    },
    {
      "expected": null,
      "input": "http://example.com:47821/panel",
      "name": "other host"
    },
    {
      "expected": null,
      "input": "http://[::1]:47821/panel",
      "name": "ipv6 loopback"
    },
    {
      "expected": null,
