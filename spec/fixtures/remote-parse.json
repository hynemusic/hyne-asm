{
  "area": "remote.parse",
  "cases": [
    {
      "expected": {
        "insert": "Serum 2"
      },
      "input": "hyneasm://insert?name=Serum%202",
      "name": "scheme insert"
    },
    {
      "expected": {
        "insert": "Pro-Q 4"
      },
      "input": "http://127.0.0.1:47821/insert?name=Pro-Q%204",
      "name": "http insert"
    },
    {
      "expected": {
        "insert": "Pro-Q 4"
      },
      "input": "http://localhost:47821/insert?name=Pro-Q%204",
      "name": "localhost insert"
    },
    {
      "expected": null,
      "input": "http://LOCALHOST:47821/panel",
