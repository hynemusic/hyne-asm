{
  "area": "search.tuning",
  "cases": [
    {
      "expected": "ser um",
      "input": {
        "normalize": "  Ser  UM "
      },
      "name": "normalize '  Ser  UM '"
    },
    {
      "expected": "serum",
      "input": {
        "normalize": "SERUM"
      },
      "name": "normalize 'SERUM'"
    },
    {
      "expected": "",
      "input": {
        "normalize": ""
      },
      "name": "normalize ''"
    },
    {
      "expected": "a b c",
      "input": {
        "normalize": "a\tb\nc"
      },
      "name": "normalize 'a\tb\nc'"
    },
    {
      "expected": "über verb",
      "input": {
        "normalize": "Über  Verb"
      },
      "name": "normalize 'Über  Verb'"
    },
    {
      "expected": "ser",
      "input": {
        "rule": "serum",
        "rules": [
          "se",
          "Ser "
        ]
      },
      "name": "longest prefix wins"
    },
    {
      "expected": null,
      "input": {
        "rule": "sa",
        "rules": [
          "se",
          "Ser "
        ]
      },
      "name": "no rule matches"
    },
    {
      "expected": null,
      "input": {
        "rule": "  ",
        "rules": [
          "se",
          "Ser "
        ]
      },
      "name": "blank search"
    },
    {
      "expected": "ser",
      "input": {
        "rule": "serum",
        "rules": [
          "ser",
          "ser",
          "se"
        ]
      },
      "name": "first of equal length"
    },
    {
      "expected": null,
      "input": {
        "rule": "se",
        "rules": [
          "ser"
        ]
      },
      "name": "rule not a word prefix"
    },
    {
      "expected": "über",
      "input": {
        "rule": "über verb",
        "rules": [
          "über"
        ]
      },
      "name": "NFD search, NFC rule"
    },
    {
      "expected": "serum 2",
      "input": {
        "rule": "  SERUM  2",
        "rules": [
          "serum 2",
          "serum"
        ]
      },
      "name": "upper search"
    },
    {
      "expected": [
        "c",
        "z",
        "a",
        "d"
      ],
      "input": {
        "apply": [
          "a",
          "b",
          "c",
          "d"
        ],
        "inject": [
          "z"
        ],
        "rule": {
          "hidden": [
            "b"
          ],
          "pinned": [
            "c",
            "z",
            "a"
          ],
          "query": "x"
        }
      },
      "name": "apply pins hides injects"
    },
    {
      "expected": [
        "a",
        "b"
      ],
      "input": {
        "apply": [
          "a",
          "b"
        ],
        "inject": [],
        "rule": null
      },
      "name": "apply no rule"
    },
    {
      "expected": [
        "c",
        "a"
      ],
      "input": {
        "apply": [
          "a",
          "b",
          "c"
        ],
        "inject": [
          "b"
        ],
        "rule": {
          "hidden": [
            "b"
          ],
          "pinned": [
            "b",
            "q",
            "c",
            "c"
          ],
          "query": "x"
        }
      },
      "name": "apply hidden pin skipped"
    },
    {
      "expected": [
        "a",
        "b"
      ],
      "input": {
        "apply": [
          "a",
          "b",
          "a"
        ],
        "inject": [],
        "rule": {
          "hidden": [],
          "pinned": [
            "a"
          ],
          "query": "x"
        }
      },
      "name": "apply duplicates"
    },
    {
      "expected": [
        "plugins|über",
        "plugins|b"
      ],
      "input": {
        "apply": [
          "plugins|über",
          "plugins|b"
        ],
        "inject": [],
        "rule": {
          "hidden": [],
          "pinned": [
            "plugins|über"
          ],
          "query": "x"
        }
      },
      "name": "apply NFD keys"
    },
    {
      "expected": [
        {
          "hidden": [
            "a"
          ],
          "pinned": [
            "b"
          ],
          "query": "ser"
        }
